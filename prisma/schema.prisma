generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USUARIOS Y AUTENTICACIÓN
// ============================================

model User {
  id       String @id @default(cuid(2))
  email    String @unique
  name     String
  password String // Usar bcrypt para hashear

  // Preferencias de usuario
  defaultCurrency String @default("MXN") @map("default_currency")
  timezone        String @default("America/Mexico_City")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  // Relaciones
  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  creditCardPeriods     CreditCardPeriod[]
  financialGoals        FinancialGoal[]
  reminders             Reminder[]
  installments          Installment[]
  refreshTokens         RefreshToken[]

  @@map("users")
}

// ============================================
// REFRESH TOKENS (Para autenticación JWT)
// ============================================

model RefreshToken {
  id     String @id @default(cuid(2))
  token  String @unique // Hash SHA-256 del token
  userId String @map("user_id")

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  wasUsed   Boolean  @default(false) @map("was_used") // Detecta reuso de tokens

  // Metadata de seguridad
  userAgent String? @map("user_agent") @db.Text
  ipAddress String? @map("ip_address")

  // Relación
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================
// CUENTAS (Bancarias y Tarjetas de Crédito)
// ============================================

enum AccountType {
  CHECKING // Cuenta de cheques
  SAVINGS // Cuenta de ahorros
  CREDIT_CARD // Tarjeta de crédito
  CASH // Efectivo
  INVESTMENT // Inversiones
}

model Account {
  id       String      @id @default(cuid(2))
  userId   String      @map("user_id")
  name     String // Ej: "Cuenta Principal", "BBVA Tarjeta Oro"
  type     AccountType
  bankName String?     @map("bank_name")
  currency String      @default("MXN") // ISO 4217

  // Balance calculado (se actualiza con triggers o mediante aplicación)
  currentBalance Decimal @default(0) @map("current_balance") @db.Decimal(15, 2)

  // Para tarjetas de crédito
  creditLimit       Decimal? @map("credit_limit") @db.Decimal(15, 2)
  cutoffDay         Int?     @map("cutoff_day") // Día de corte (1-31)
  paymentDueDays    Int?     @map("payment_due_days") // Días después del corte para pagar
  interestRate      Decimal? @map("interest_rate") @db.Decimal(5, 2) // Tasa de interés anual
  minimumPaymentPct Decimal? @map("minimum_payment_pct") @db.Decimal(5, 2) // % de pago mínimo

  // Metadata
  lastFourDigits String? @map("last_four_digits") // Últimos 4 dígitos de tarjeta
  color          String? // Color para UI
  icon           String? // Ícono para UI
  notes          String? @db.Text

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  creditCardPeriods     CreditCardPeriod[]
  balanceHistory        BalanceHistory[]
  installments          Installment[]

  @@index([userId])
  @@index([type])
  @@index([isActive])
  @@map("accounts")
}

// ============================================
// HISTORIAL DE BALANCE (Para gráficas y auditoría)
// ============================================

model BalanceHistory {
  id        Int      @id @default(autoincrement())
  accountId String   @map("account_id")
  balance   Decimal  @db.Decimal(15, 2)
  date      DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@map("balance_history")
}

// ============================================
// PERÍODOS DE TARJETA DE CRÉDITO
// ============================================

model CreditCardPeriod {
  id        Int    @id @default(autoincrement())
  accountId String @map("account_id")
  userId    String @map("user_id")

  cutoffDate DateTime @map("cutoff_date") // Fecha de corte
  dueDate    DateTime @map("due_date") // Fecha límite de pago

  totalAmount    Decimal @map("total_amount") @db.Decimal(15, 2) // Total del período
  minimumPayment Decimal @map("minimum_payment") @db.Decimal(15, 2) // Pago mínimo
  paidAmount     Decimal @default(0) @map("paid_amount") @db.Decimal(15, 2) // Cantidad pagada

  isPaid    Boolean  @default(false) @map("is_paid")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([accountId])
  @@index([userId])
  @@index([cutoffDate])
  @@index([dueDate])
  @@map("credit_card_periods")
}

// ============================================
// CATEGORÍAS
// ============================================

enum CategoryType {
  INCOME // Ingresos
  EXPENSE // Gastos
}

model Category {
  id     Int          @id @default(autoincrement())
  userId String?      @map("user_id")
  name   String
  type   CategoryType
  icon   String? // Emoji o nombre de ícono
  color  String? // Color hexadecimal para UI

  // Categorías padre (para subcategorías)
  parentId Int? @map("parent_id")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent                Category?              @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories         Category[]             @relation("CategoryHierarchy")
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
  @@index([parentId])
  @@index([type])
  @@map("categories")
}

// ============================================
// TRANSACCIONES
// ============================================

enum TransactionType {
  INCOME // Ingreso
  EXPENSE // Gasto
  TRANSFER // Transferencia entre cuentas propias
  ADJUSTMENT // Ajuste manual de balance
}

enum TransactionStatus {
  PENDING // Pendiente (para transacciones futuras)
  COMPLETED // Completada
  CANCELLED // Cancelada
}

model Transaction {
  id         String @id @default(cuid(2))
  userId     String @map("user_id")
  accountId  String @map("account_id")
  categoryId Int?   @map("category_id")

  type   TransactionType
  status TransactionStatus @default(COMPLETED)
  amount Decimal           @db.Decimal(15, 2) // Siempre positivo

  description String?
  notes       String?  @db.Text
  date        DateTime @default(now()) // Fecha de la transacción

  // Para transferencias
  relatedTransactionId String? @unique @map("related_transaction_id") // ID de la transacción contraria
  isTransferSource     Boolean @default(false) @map("is_transfer_source") // true si es el origen

  // Para tarjetas de crédito
  creditCardPeriodId Int? @map("credit_card_period_id")

  // Para rastrear si es parte de una transacción recurrente
  recurringTransactionId Int? @map("recurring_transaction_id")

  // Metadata
  attachments String[] // URLs o rutas de archivos adjuntos
  tags        String[] // Etiquetas para búsqueda

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Para auditoría
  isEdited       Boolean   @default(false) @map("is_edited")
  editedAt       DateTime? @map("edited_at")
  originalAmount Decimal?  @map("original_amount") @db.Decimal(15, 2)

  // Relaciones
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  creditCardPeriod     CreditCardPeriod?     @relation(fields: [creditCardPeriodId], references: [id], onDelete: SetNull)
  relatedTransaction   Transaction?          @relation("TransferRelation", fields: [relatedTransactionId], references: [id], onDelete: SetNull)
  transferRelation     Transaction?          @relation("TransferRelation")
  installmentOriginal  Installment?          @relation("InstallmentOriginal")
  installmentPayment   InstallmentPayment?   @relation("InstallmentPayment")

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([date])
  @@index([type])
  @@index([status])
  @@index([recurringTransactionId])
  @@map("transactions")
}

// ============================================
// TRANSACCIONES RECURRENTES (AUTOMATIZADAS)
// ============================================

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY // Quincenal
  MONTHLY
  QUARTERLY // Trimestral
  YEARLY
}

model RecurringTransaction {
  id         Int    @id @default(autoincrement())
  userId     String @map("user_id")
  accountId  String @map("account_id")
  categoryId Int?   @map("category_id")

  type        TransactionType
  amount      Decimal         @db.Decimal(15, 2)
  description String?
  notes       String?         @db.Text

  frequency RecurrenceFrequency
  startDate DateTime            @map("start_date")
  endDate   DateTime?           @map("end_date") // Null = sin fecha de fin
  nextDate  DateTime            @map("next_date") // Próxima ejecución

  // Configuración avanzada
  dayOfMonth       Int?    @map("day_of_month") // Para MONTHLY (1-31)
  dayOfWeek        Int?    @map("day_of_week") // Para WEEKLY (0-6, domingo=0)
  autoCreate       Boolean @default(true) @map("auto_create") // Crear automáticamente o notificar
  notifyBeforeDays Int?    @map("notify_before_days") // Días antes para notificar

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lastExecuted DateTime? @map("last_executed") // Última vez que se ejecutó

  // Relaciones
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[] // Transacciones generadas

  @@index([userId])
  @@index([accountId])
  @@index([nextDate])
  @@index([isActive])
  @@map("recurring_transactions")
}

// ============================================
// PRESUPUESTOS
// ============================================

model Budget {
  id         Int    @id @default(autoincrement())
  userId     String @map("user_id")
  categoryId Int    @map("category_id")

  amount Decimal @db.Decimal(15, 2)
  month  Int // 1-12
  year   Int

  // Para alertas
  alertThreshold Decimal? @map("alert_threshold") @db.Decimal(5, 2) // % para alertar (ej: 80 = alertar al 80%)

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId])
  @@index([categoryId])
  @@index([year, month])
  @@map("budgets")
}

// ============================================
// MESES SIN INTERESES (MSI)
// ============================================

enum InstallmentStatus {
  ACTIVE // Activo, generando pagos
  COMPLETED // Todos los pagos realizados
  CANCELLED // Cancelado (se cobrará el saldo completo)
}

model Installment {
  id            Int    @id @default(autoincrement())
  userId        String @map("user_id")
  accountId     String @map("account_id")
  transactionId String @unique @map("transaction_id") // Transacción original de compra (única)

  description     String // Ej: "iPhone 15 Pro"
  principalAmount Decimal @map("principal_amount") @db.Decimal(15, 2) // Monto original sin intereses
  totalAmount     Decimal @db.Decimal(15, 2) // Monto total CON intereses (si aplica)
  monthlyAmount   Decimal @map("monthly_amount") @db.Decimal(15, 2) // Pago mensual

  // Campos para intereses
  hasInterest   Boolean  @default(false) @map("has_interest") // true = con intereses, false = MSI
  interestRate  Decimal? @map("interest_rate") @db.Decimal(5, 2) // Tasa anual (ej: 18.00)
  totalInterest Decimal? @map("total_interest") @db.Decimal(15, 2) // Total de intereses a pagar

  totalMonths     Int     @map("total_months") // Total de meses (ej: 6, 12, 18)
  paidMonths      Int     @default(0) @map("paid_months") // Meses ya pagados
  remainingAmount Decimal @default(0) @map("remaining_amount") @db.Decimal(15, 2) // Saldo pendiente

  startDate       DateTime @map("start_date") // Fecha de inicio
  nextPaymentDate DateTime @map("next_payment_date") // Próximo pago

  status InstallmentStatus @default(ACTIVE)

  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  // Relaciones
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  originalTransaction Transaction          @relation("InstallmentOriginal", fields: [transactionId], references: [id], onDelete: Restrict)
  payments            InstallmentPayment[]

  @@index([userId])
  @@index([accountId])
  @@index([status])
  @@index([nextPaymentDate])
  @@map("installments")
}

model InstallmentPayment {
  id            Int    @id @default(autoincrement())
  installmentId Int    @map("installment_id")
  transactionId String @unique @map("transaction_id") // Transacción de pago mensual (única)

  monthNumber Int      @map("month_number") // Número de pago (1, 2, 3...)
  amount      Decimal  @db.Decimal(15, 2)
  dueDate     DateTime @map("due_date") // Fecha en que debía pagarse
  paidDate    DateTime @map("paid_date") // Fecha en que se pagó

  createdAt DateTime @default(now()) @map("created_at")

  // Relaciones
  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  transaction Transaction @relation("InstallmentPayment", fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([installmentId, monthNumber])
  @@index([installmentId])
  @@map("installment_payments")
}

// ============================================
// METAS FINANCIERAS
// ============================================

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model FinancialGoal {
  id          Int     @id @default(autoincrement())
  userId      String  @map("user_id")
  name        String
  description String? @db.Text

  targetAmount  Decimal @map("target_amount") @db.Decimal(15, 2)
  currentAmount Decimal @default(0) @map("current_amount") @db.Decimal(15, 2)

  deadline DateTime?
  status   GoalStatus @default(ACTIVE)

  color String?
  icon  String?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  // Relaciones
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("financial_goals")
}

// ============================================
// RECORDATORIOS
// ============================================

enum ReminderType {
  BILL_DUE // Factura por vencer
  BUDGET_ALERT // Alerta de presupuesto
  GOAL_MILESTONE // Hito de meta
  CUSTOM // Personalizado
}

model Reminder {
  id      Int          @id @default(autoincrement())
  userId  String       @map("user_id")
  type    ReminderType
  title   String
  message String?      @db.Text

  reminderDate DateTime @map("reminder_date")

  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  // Relaciones
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reminderDate])
  @@index([isRead])
  @@map("reminders")
}
